# Скопировать в .env. URL — из кнопки «Открыть GET для DEV» в гайде, БЕЗ параметра group_id
CQA_API_URL=

# Оценка: llm — моделями, mock — фейковые ответы без затрат (для разработки UI/API)
SCORING_MODE=llm

# Кто оценивает. Уровни через «|»: следующий уровень включается, только если предыдущий не ответил.
#   claude_cli            — локальный Claude Code по подписке
#   claude_cli@~/.claude-b — второй аккаунт Claude Code (CLAUDE_CONFIG_DIR=~/.claude-b claude → /login)
#   codex_cli             — локальный Codex по подписке ChatGPT
#   anthropic             — Claude API по ANTHROPIC_API_KEY (демо, честная цена для README)
LLM_PROVIDERS=claude_cli | codex_cli
# Сколько независимых ответов собрать и сравнить (голосование по каждому критерию)
LLM_SAMPLES=3

ANTHROPIC_API_KEY=
# Модель Claude: claude-opus-5-5 (по умолчанию) | claude-sonnet-5-5 | claude-haiku-5-5
LLM_MODEL=
LLM_EFFORT=medium
# Модель Codex, доступная для входа через ChatGPT
CODEX_MODEL=gpt-5.6-terra
