# Скопировать в .env. URL — из кнопки «Открыть GET для DEV» в гайде, БЕЗ параметра group_id
CQA_API_URL=

# Оценка: llm — моделями, mock — фейковые ответы без затрат (для разработки UI/API)
SCORING_MODE=llm
# Для гибридного режима выберите preset providers=hybrid в API/UI либо задайте SCORING_STRATEGY=hybrid
SCORING_STRATEGY=
HYBRID_VLM_PROVIDER=local
HYBRID_LM_PROVIDER=local_lm
HYBRID_DEADLINE_SECONDS=120

# Кто оценивает. Уровни через «|»: следующий уровень включается, только если предыдущий не ответил.
#   claude_cli            — локальный Claude Code по подписке
#   claude_cli@~/.claude-b — второй аккаунт Claude Code (CLAUDE_CONFIG_DIR=~/.claude-b claude → /login)
#   codex_cli             — локальный Codex по подписке ChatGPT
#   anthropic             — Claude API по ANTHROPIC_API_KEY (демо, честная цена для README)
#   local                 — локальная MLX-VLM модель через OpenAI-совместимый API
LLM_PROVIDERS=claude_cli | codex_cli
# Сколько независимых ответов собрать и сравнить (голосование по каждому критерию)
LLM_SAMPLES=3

ANTHROPIC_API_KEY=
# Модель Claude: claude-opus-5-5 (по умолчанию) | claude-sonnet-5-5 | claude-haiku-5-5
LLM_MODEL=
LLM_EFFORT=medium
# Модель Codex, доступная для входа через ChatGPT
CODEX_MODEL=gpt-5.6-terra

# Локальная MLX-VLM модель (текстовые запросы без изображений), запуск: bash scripts/start_local_vlm.sh
LOCAL_LLM_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=mlx-community/Qwen3.5-4B-MLX-4bit
LOCAL_LLM_MAX_TOKENS=3072
LOCAL_LLM_TIMEOUT=600
LOCAL_LLM_REPETITION_PENALTY=1.0

# Отдельный текстовый LM-сервер для fallback (например, mlx_lm.server)
LOCAL_TEXT_LLM_URL=http://localhost:8081/v1
LOCAL_TEXT_LLM_MODEL=
LOCAL_TEXT_LLM_MAX_TOKENS=3072
LOCAL_TEXT_LLM_TIMEOUT=600
LOCAL_TEXT_LLM_REPETITION_PENALTY=1.0

# Пароль для публичной ссылки Cloudflare (scripts/tunnel.sh): логин:пароль. Локально не спрашивается.
CQA_BASIC_AUTH=

# Сдача результатов (tools/export_results.py)
TEAM_NAME=sol32267
MODEL_MODE=external_api
# Распознавание загруженных записей: tiny|base|small|medium|large-v3 (качество KZ растёт с размером)
ASR_MODEL=small
